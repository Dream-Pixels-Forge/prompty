{
  "manifest_version": 3,
  "name": "Prompty — Global Prompt Library",
  "version": "0.3.0",
  "description": "Save, organize, and paste prompts on any site",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/assist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-library": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Open the Prompty library"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current selection as a prompt"
    },
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Toggle the floating widget"
    }
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Prompty",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
