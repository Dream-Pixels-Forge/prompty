{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.1",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/assist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-library": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "__MSG_cmdOpenLibrary__"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveSelection__"
    },
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "__MSG_cmdToggleWidget__"
    }
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Prompty",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "default_locale": "en"
}
