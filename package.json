{
  "name": "prompty",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Save, organize, and paste prompts on any site",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "node scripts/build.mjs && node scripts/validate-manifests.mjs",
    "validate": "node scripts/validate-manifests.mjs",
    "package": "node scripts/build.mjs && node scripts/validate-manifests.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  }
}
